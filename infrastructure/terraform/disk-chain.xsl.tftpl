<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
  <xsl:output method="xml" omit-xml-declaration="yes"/>

  <xsl:template match="@*|node()">
    <xsl:copy>
      <xsl:apply-templates select="@*|node()"/>
    </xsl:copy>
  </xsl:template>

  <!-- File attachment lets virt-aa-helper see the complete disk chain. -->
  <xsl:template match="/domain/devices/disk[@device='disk' and (source/@file='${guest_disk_path}' or (source/@pool='${pool_name}' and source/@volume='${guest_disk_name}'))]">
    <xsl:copy>
      <xsl:apply-templates select="@*[name() != 'type']"/>
      <xsl:attribute name="type">file</xsl:attribute>
      <xsl:apply-templates select="node()[not(self::backingStore)]"/>
      <backingStore type="file">
        <format type="qcow2"/>
        <source file="${base_disk_path}"/>
        <backingStore/>
      </backingStore>
    </xsl:copy>
  </xsl:template>

  <xsl:template match="/domain/devices/disk[@device='disk' and (source/@file='${guest_disk_path}' or (source/@pool='${pool_name}' and source/@volume='${guest_disk_name}'))]/source">
    <source file="${guest_disk_path}"/>
  </xsl:template>

  <!-- Specify qcow2 explicitly rather than depending on format probing. -->
  <xsl:template match="/domain/devices/disk[@device='disk' and (source/@file='${guest_disk_path}' or (source/@pool='${pool_name}' and source/@volume='${guest_disk_name}'))]/driver">
    <xsl:copy>
      <xsl:apply-templates select="@*[name() != 'type']"/>
      <xsl:attribute name="type">qcow2</xsl:attribute>
      <xsl:apply-templates select="node()"/>
    </xsl:copy>
  </xsl:template>
</xsl:stylesheet>
