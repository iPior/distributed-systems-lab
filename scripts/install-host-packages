#!/usr/bin/env bash
# Run as your normal user on the Optiplex, not as root.
set -euo pipefail
ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
export LC_ALL=C.UTF-8
RECORD="$ROOT/.local/install-records/$(date -u +%Y%m%dT%H%M%SZ)-$$"
mkdir -p "$RECORD"
chmod 700 "$ROOT/.local" "$ROOT/.local/install-records" "$RECORD"

snapshot() {
  dpkg-query -W -f='${binary:Package}\t${Version}\t${db:Status-Status}\n' | sort > "$RECORD/$1-packages.tsv"
  apt-mark showmanual | sort > "$RECORD/$1-manual.txt"
  apt-mark showauto | sort > "$RECORD/$1-auto.txt"
}

finish() {
  result=$?
  trap - EXIT
  snapshot after
  python3 - "$RECORD" "$result" <<'PY'
import pathlib, sys
directory = pathlib.Path(sys.argv[1])
def packages(stage):
    rows = (directory / f'{stage}-packages.tsv').read_text().splitlines()
    return {p: v for p, v, status in (r.split('\t') for r in rows) if status == 'installed'}
before, after = packages('before'), packages('after')
new = sorted(after.keys() - before.keys())
removed = sorted(before.keys() - after.keys())
changed = sorted(p for p in before.keys() & after.keys() if before[p] != after[p])
lines = ['# Host package installation record', '', f'Installer exit status: {sys.argv[2]}', '',
         '## Newly installed packages', '', '| Package | Installed version |', '| --- | --- |']
lines += [f'| {p} | {after[p]} |' for p in new]
lines += ['', '## Upgraded or changed packages', '', '| Package | Before | After |', '| --- | --- | --- |']
lines += [f'| {p} | {before[p]} | {after[p]} |' for p in changed]
lines += ['', '## Removed packages', ''] + ([f'- {p}' for p in removed] or ['None.'])
lines += ['', '## Removal planning', '',
          'This records a before/after difference, not an automatically safe removal list.',
          'Before removal, destroy approved lab resources, inspect reverse dependencies,',
          'and simulate the exact proposed removal. Some packages may later be used elsewhere.',
          'Do not use broad autoremove or purge. Package removal does not undo upgrades,',
          'group memberships, service state, network definitions, or generated VM storage.',
          'The accompanying before/after manual and auto lists preserve APT selection state.',
          'Do not run other package transactions concurrently with this installation.', '']
(directory / 'summary.md').write_text('\n'.join(lines))
(directory / 'new-packages.txt').write_text(''.join(p + '\n' for p in new))
print(f'Installation record: {directory / "summary.md"}')
PY
  exit "$result"
}

if [[ $EUID -eq 0 ]]; then
  echo 'Run this script as your normal user; it invokes sudo when needed.' >&2
  exit 1
fi
sudo -v
snapshot before
trap finish EXIT
packages=(qemu-system-x86 qemu-utils libvirt-daemon-system libvirt-clients ansible-core xorriso xsltproc)
printf '%s\n' "${packages[@]}" > "$RECORD/requested-packages.txt"
sudo apt-get update 2>&1 | tee "$RECORD/apt-update.log"
sudo apt-get --simulate --no-install-recommends --no-remove install "${packages[@]}" \
  2>&1 | tee "$RECORD/apt-plan.log"
echo
echo 'Review the transaction above. Libvirt may start services and its default NAT network.'
echo 'This does not create the experiment VM. Reject unexpected upgrades or removals.'
sudo apt-get --no-install-recommends --no-remove install "${packages[@]}" \
  2>&1 | tee "$RECORD/apt-install.log"

{
  ansible-playbook --version
  virsh --version
  qemu-system-x86_64 --version
  qemu-img --version
  xorriso -version
} > "$RECORD/tool-versions.txt" 2>&1
sudo virsh --connect qemu:///system net-list --all > "$RECORD/libvirt-networks-after.txt"
echo 'Package installation finished. No group memberships were changed.'
